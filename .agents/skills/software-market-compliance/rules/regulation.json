    "(?:does not|doesn't|do not|don't|never)\\s+(?:collect|store|share|use)\\s+(?:your\\s+)?(?:precise\\s+)?(?:location|GPS|geolocation)",
    "(?:no|without)\\s+(?:precise\\s+)?(?:location|GPS)\\s+(?:data|collection)"
  ],
